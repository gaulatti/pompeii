# Existing Route 53 zone that will receive pompeii.<zone> records.
HOSTED_ZONE_ID=Z0123456789EXAMPLE
HOSTED_ZONE_NAME=example.com

# Existing Secrets Manager entry containing the UNIQUE_KEY object consumed by
# the Pompeii backend.
SECRET_ARN=arn:aws:secretsmanager:us-east-1:000000000000:secret:applications-ABCDEF
